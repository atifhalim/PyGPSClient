# Configuration for the gnss-server (user) systemd service.
# Copy to ~/.config/gnss-server.env and edit. GNSS_SERVER_ARGS is word-split by
# systemd, so single spaces between flags/values and no surrounding quotes.
#
# gnssserver reads the base receiver on USB and re-serves the raw stream
# (UBX/NMEA + RTCM3) over a local TCP socket, so BOTH the RTCM->MAVLink injector
# and the PyGPSClient GUI can use one receiver at once:
#   * the injector reads it with   --rtcm-tcp 127.0.0.1:50010
#   * the GUI connects as a TCP client to  Server: localhost  Port: 50010
#
# Bound to 127.0.0.1 (local only). Use --hostip 0.0.0.0 to also allow other
# machines on the network to connect (e.g. a laptop) - only if you want that.
GNSS_SERVER_ARGS=--inport /dev/ttyACM0 --baudrate 115200 --hostip 127.0.0.1 --outport 50010 --maxclients 5
