# Configuration for the rtcm-base-setup service (gnss-base).
# Copy to ~/.config/rtcm-base.env and edit. GNSS_BASE_ARGS is word-split by systemd,
# so single spaces between flags/values and no surrounding quotes.
#
# Survey-in base (location changes between deployments), persisted so it comes
# back configured after a power-cycle:
GNSS_BASE_ARGS=--port /dev/rtk-base --mode svin --svin-dur 60 --svin-acc 2.0 --persist

# Fixed base at a known surveyed monument (cm-accurate, instant start):
# GNSS_BASE_ARGS=--port /dev/rtk-base --mode fixed --lat 53.450012345 --lon -2.312345678 --height 74.321 --persist
