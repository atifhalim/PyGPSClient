[Unit]
# Headless RTCM3 -> MAVLink GPS_RTCM_DATA injector (pygpsclient rtcm-mavlink).
# Reads RTCM3 from a local base and injects it onto a MAVLink link (e.g. a
# Herelink Wi-Fi stream) so the autopilot relays corrections to the rover.
Description=RTCM3 to MAVLink injector (PyGPSClient)
Documentation=https://github.com/atifhalim/PyGPSClient/blob/master/docs/jetson_deploy.md
# Start after the network is up and the base receiver has been configured
After=network-online.target rtcm-base-setup.service
Wants=network-online.target rtcm-base-setup.service

[Service]
Type=simple
# Configuration (RTCM source, MAVLink dest, monitor) lives in this env file.
EnvironmentFile=/etc/rtcm-mavlink.env
# $RTCM_MAVLINK_ARGS is intentionally unquoted so systemd word-splits it into
# separate CLI arguments. Point ExecStart at the venv's console script.
ExecStart=/opt/pygpsclient/venv/bin/rtcm-mavlink $RTCM_MAVLINK_ARGS
# Keep it running across base reboots, transient USB dropouts, link loss
Restart=always
RestartSec=3
# A non-root service account that is a member of the 'dialout' group (for
# serial access). Create it once: see docs/jetson_deploy.md.
User=rtk
Group=rtk
SupplementaryGroups=dialout
# Light hardening (loosen only if a step needs more)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Allow writing GCP/log output under this dir if the tool is configured to
ReadWritePaths=/var/lib/rtcm-mavlink

[Install]
WantedBy=multi-user.target
