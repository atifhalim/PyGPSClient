# Configuration for the rtcm-mavlink (user) systemd service.
# Copy to ~/.config/rtcm-mavlink.env and edit for your setup.
#
# RTCM_MAVLINK_ARGS is passed verbatim to the `rtcm-mavlink` CLI. It is
# word-split by systemd, so separate each flag/value with a single space and
# do NOT add surrounding quotes.
#
# RTCM source  (choose ONE): --rtcm-serial <dev> [--baud N] | --rtcm-tcp host:port | --rtcm-file path
# MAVLink dest (required):   --dest udpout:<ip>:<port>
# Optional monitor:          --monitor udpin:0.0.0.0:14550   (prints RTK verdict to the journal)
#
# Example 1 - local F9P/Here 4 base on USB, inject onto a Herelink Wi-Fi stream:
RTCM_MAVLINK_ARGS=--rtcm-serial /dev/rtk-base --baud 115200 --dest udpout:192.168.144.11:14552 --monitor udpin:0.0.0.0:14550

# Example 2 - read corrections from a local caster (RTKBase / gnssserver) instead:
# RTCM_MAVLINK_ARGS=--rtcm-tcp 127.0.0.1:2101 --dest udpout:192.168.144.11:14552
