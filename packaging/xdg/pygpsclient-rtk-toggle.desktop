[Desktop Entry]
# Touchscreen button to pause/resume RTK corrections to the drone WITHOUT
# closing the app: it toggles only the injector (rtcm-mavlink). The relay and
# the GUI keep running, so the base view and GCP capture stay live. A desktop
# notification shows the new state. Copy to ~/.local/share/applications/ (or
# ~/Desktop) and set Exec= to the full path, e.g.:
#   /home/atif/miniforge3/envs/rtk/bin/pygpsclient-rtk toggle
Type=Application
Name=RTK Injection (toggle)
Comment=Pause/resume RTCM corrections to the drone (injector only)
Exec=/home/atif/miniforge3/envs/rtk/bin/pygpsclient-rtk toggle
Icon=pygpsclient
Terminal=false
Categories=Utility;Science;Geoscience;
